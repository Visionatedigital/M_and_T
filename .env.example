# Copy to `.env` and adjust. See electron/update.cjs and electron-builder.config.cjs.

# --- Desktop auto-update (Electron) — pick ONE approach ---
# Releases: https://github.com/Visionatedigital/M_and_T/releases

# Generic HTTPS folder containing `latest.yml` + installers (trailing slash OK).
UPDATE_BASE_URL=https://github.com/Visionatedigital/M_and_T/releases/latest/download/

# OR use GitHub provider instead of UPDATE_BASE_URL (typical for `electron-builder publish`):
# GITHUB_OWNER=Visionatedigital
# GITHUB_REPO=M_and_T

# --- Publishing a release (`npm run electron:publish:win`) ---
# Fine-grained token: Contents read/write on the repo. Classic: repo scope.
# GH_TOKEN=ghp_...

# --- Web / Node API (DigitalOcean + Supabase) ---
# Supabase: Project Settings → Database → Connection string (use pooler for server).
# DATABASE_URL=postgresql://...
# JWT_SECRET=change-me-long-random
# PORT=3000

# Vite production build (set before `npm run build`; values are baked into dist/):
# VITE_REMOTE_API_URL=https://your-domain.com
# VITE_USE_SUPABASE=true
# Supabase → Settings → API (anon / publishable key — not the DB password):
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...
# Service role — scripts only (recreate_test_accounts); never ship to browser:
# VITE_SUPABASE_SERVICE_ROLE_KEY=eyJ...
